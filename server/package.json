{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc -p tsconfig.migrations.json",
    "start": "node dist/index.js",
    "hash-password": "node scripts/hash-password.mjs",
    "migrate:prod": "node-pg-migrate up -m dist/migrations",
    "migrate:up": "node-pg-migrate up -m migrations --envPath ../.env",
    "migrate:down": "node-pg-migrate down -m migrations --envPath ../.env",
    "migrate:create": "node-pg-migrate create -m migrations --envPath ../.env",
    "test": "jest --passWithNoTests",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
