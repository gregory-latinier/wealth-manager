# Copy to .env for local development. In production (o2switch) these are set in the
# cPanel "Setup Node.js App" screen: there is no .env file on the server.

# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL=postgresql://wmuser:wmpassword@localhost:5433/wealthmanager

# Port for local development (Passenger injects its own in production)
PORT=3001
APP_PASSWORD_HASH=
SNAPSHOT_TOKEN=
